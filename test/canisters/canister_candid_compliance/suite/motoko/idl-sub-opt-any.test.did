/*
Ported from dfinity/motoko test/run-drun/idl-sub-opt-any.mo.
Each //CALL is an assert at the method's parameter types (Motoko -> Candid:
Nat nat, Int int, Text text, Char nat32, Float float64, Any reserved, None empty,
Null null, ?T opt T, [T] vec T, (T, U) record { T; U } or an argument list,
{#a : T} variant { a : T }, actor {..} service {..}, shared .. -> async .. func).
A trap (IDL error) is !:, a reply is : (with the decoded value where useful).
*/
assert blob "DIDL\02\6a\00\01\01\00\6a\02\7c\7f\02\7e\7f\00\01\00\01\01\00\01\6d" == "(opt func \"aaaaa-aa\".m)" : (opt func () -> (func (int) -> (bool))) "idl-sub-opt-any.mo f0_1_a: func (int, null) -> (bool, null) <: func (int) -> (bool)";
assert blob "DIDL\03\6a\00\01\01\00\6a\02\7c\02\02\7e\02\00\6e\7f\01\00\01\01\00\01\6d" == "(opt func \"aaaaa-aa\".m)" : (opt func () -> (func (int) -> (bool))) "idl-sub-opt-any.mo f0_1_b: func (int, opt null) -> (bool, opt null) <: func (int) -> (bool)";
assert blob "DIDL\02\6a\00\01\01\00\6a\02\7c\70\02\7e\70\00\01\00\01\01\00\01\6d" == "(opt func \"aaaaa-aa\".m)" : (opt func () -> (func (int) -> (bool))) "idl-sub-opt-any.mo f0_1_c: func (int, reserved) -> (bool, reserved) <: func (int) -> (bool)";
assert blob "DIDL\03\6a\00\01\01\00\6a\02\02\7c\02\02\7e\00\6e\7f\01\00\01\01\00\01\6d" == "(null)" : (opt func () -> (func (int) -> (bool))) "idl-sub-opt-any.mo f0_1_d: func (opt null, int) -> (opt null, bool) </: func (int) -> (bool)";
assert blob "DIDL\02\6a\00\01\01\00\6a\02\70\7c\02\70\7e\00\01\00\01\01\00\01\6d" == "(null)" : (opt func () -> (func (int) -> (bool))) "idl-sub-opt-any.mo f0_1_e: func (reserved, int) -> (reserved, bool) </: func (int) -> (bool)";
