/*
Ported from dfinity/motoko test/run-drun/idl-nary.mo.
Each //CALL is an assert at the method's parameter types (Motoko -> Candid:
Nat nat, Int int, Text text, Char nat32, Float float64, Any reserved, None empty,
Null null, ?T opt T, [T] vec T, (T, U) record { T; U } or an argument list,
{#a : T} variant { a : T }, actor {..} service {..}, shared .. -> async .. func).
A trap (IDL error) is !:, a reply is : (with the decoded value where useful).
*/
assert blob "DIDL\00\02\71\71\03\4f\6e\65\03\54\77\6f" == "(\"One\", \"Two\")" : (text, text) "idl-nary.mo two";
assert blob "DIDL\00\03\71\71\71\03\4f\6e\65\03\54\77\6f\05\54\68\72\65\65" == "(\"One\", \"Two\", \"Three\")" : (text, text, text) "idl-nary.mo three";
assert blob "DIDL\00\04\71\71\71\71\03\4f\6e\65\03\54\77\6f\05\54\68\72\65\65\04\46\6f\75\72" == "(\"One\", \"Two\", \"Three\", \"Four\")" : (text, text, text, text) "idl-nary.mo four";
assert blob "DIDL\01\6c\04\00\71\01\71\02\71\03\71\01\00\03\4f\6e\65\03\54\77\6f\05\54\68\72\65\65\04\46\6f\75\72" == "(record { \"One\"; \"Two\"; \"Three\"; \"Four\" })" : (record { text; text; text; text }) "idl-nary.mo unary1..4";
assert blob "DIDL\00\02\71\71\03\4f\6e\65\03\54\77\6f" !: (text, text, text) "idl-nary.mo three: too few arguments";
assert blob "DIDL\00\03\71\71\71\03\4f\6e\65\03\54\77\6f\05\54\68\72\65\65\45\58\54\52\41\42\59\54\45\53" !: (text, text, text) "idl-nary.mo three: left-over bytes";
assert blob "DIDL\00\05\71\71\71\71\71\03\4f\6e\65\03\54\77\6f\05\54\68\72\65\65\04\46\6f\75\72\04\46\69\76\65" == "(\"One\", \"Two\", \"Three\", \"Four\")" : (text, text, text, text) "idl-nary.mo four: extra arguments are ignored";
