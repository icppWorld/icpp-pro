/*
icpp-candid's own encode vectors, for values of the official suite, with
references from didc 0.6.2 `didc encode`. They were checked byte for byte in
canister_1 before this runner existed.
*/

assert "()" encode blob "DIDL\00\00" : () "prim: nullary";
assert "(null)" encode blob "DIDL\00\01\7f" : (null) "prim: null";
assert "(false)" encode blob "DIDL\00\01\7e\00" : (bool) "prim: false";
assert "(true)" encode blob "DIDL\00\01\7e\01" : (bool) "prim: true";
assert "(0)" encode blob "DIDL\00\01\7d\00" : (nat) "prim: nat 0";
assert "(1)" encode blob "DIDL\00\01\7d\01" : (nat) "prim: nat 1";
assert "(127)" encode blob "DIDL\00\01\7d\7f" : (nat) "prim: nat 127, the largest one-byte leb128";
assert "(128)" encode blob "DIDL\00\01\7d\80\01" : (nat) "prim: nat 128, the smallest two-byte leb128";
assert "(16383)" encode blob "DIDL\00\01\7d\ff\7f" : (nat) "prim: nat 16383";
assert "(60000000000000000)" encode blob "DIDL\00\01\7d\80\80\98\f4\e9\b5\ca\6a" : (nat) "prim: nat 60000000000000000";
assert "(340282366920938463463374607431768211455)" encode blob "DIDL\00\01\7d\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\ff\03" : (nat) "prim: nat 2^128 - 1";
assert "(record {})" encode blob "DIDL\01\6c\00\01\00" : (record {}) "record: empty";
assert "(record {}, record {}, record {})" encode blob "DIDL\01\6c\00\03\00\00\00" : (record {}, record {}, record {}) "record: multiple records";
assert "(record { 1 = 42 })" encode blob "DIDL\01\6c\01\01\7c\01\00\2a" : (record { 1 : int }) "record";
