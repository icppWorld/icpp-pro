assert blob "DIDL\01\6b\03\b3\d3\c9\01\7f\bb\d3\c9\01\7f\e6\fd\d5\01\7f\01\00\02" == "(opt variant { Foo })" : (opt E2) "serde.rs test_extra_fields: (variant { Foo }) : (E2) decodes at (opt E2) to (opt variant { Foo })";
assert blob "DIDL\01\6b\03\b3\d3\c9\01\7f\bb\d3\c9\01\7f\e6\fd\d5\01\7f\01\00\02" == "(variant { Foo })" : (E1) "serde.rs test_extra_fields: variant { Foo } : E2 decodes at the narrower E1 (the tag is known)";

