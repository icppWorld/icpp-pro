assert blob "DIDL\02\6d\01\6c\02\00\7c\01\7c\01\00\01\09\7e" == "(vec { record { 9; -2 } })" : (vec record { int; int }) "serde.rs test_map_key_and_value_decode_under_own_type: (vec { record { 9; -2 } }) round-trips";
assert blob "DIDL\02\6d\01\6c\02\00\71\01\7c\01\00\01\01\6b\7e" == "(vec { record { \"k\"; -2 } })" : (vec record { text; int }) "serde.rs test_map_key_and_value_decode_under_own_type: (vec { record { \"k\"; -2 } }) round-trips";
assert blob "DIDL\02\6d\01\6c\02\00\7d\01\7c\01\00\01\05\80\7f" == "(vec { record { 5; -128 } })" : (vec record { nat; int }) "serde.rs test_map_key_and_value_decode_under_own_type: (vec { record { 5; -128 } }) round-trips";
assert blob "DIDL\02\6d\01\6c\02\00\7c\01\7c\01\00\01\09\80\7f" == "(vec { record { 9; -128 } })" : (vec record { int; int }) "serde.rs test_map_key_and_value_decode_under_own_type: (vec { record { 9; -128 } }) round-trips";
assert blob "DIDL\02\6d\01\6c\02\00\71\01\7c\01\00\01\01\6b\80\7f" == "(vec { record { \"k\"; -128 } })" : (vec record { text; int }) "serde.rs test_map_key_and_value_decode_under_own_type: (vec { record { \"k\"; -128 } }) round-trips";
assert blob "DIDL\02\6d\01\6c\02\00\7d\01\7c\01\00\01\05\80\80\80\80\78" == "(vec { record { 5; -2147483648 } })" : (vec record { nat; int }) "serde.rs test_map_key_and_value_decode_under_own_type: (vec { record { 5; -2147483648 } }) round-trips";
assert blob "DIDL\02\6d\01\6c\02\00\7c\01\7c\01\00\01\09\80\80\80\80\78" == "(vec { record { 9; -2147483648 } })" : (vec record { int; int }) "serde.rs test_map_key_and_value_decode_under_own_type: (vec { record { 9; -2147483648 } }) round-trips";
assert blob "DIDL\02\6d\01\6c\02\00\71\01\7c\01\00\01\01\6b\80\80\80\80\78" == "(vec { record { \"k\"; -2147483648 } })" : (vec record { text; int }) "serde.rs test_map_key_and_value_decode_under_own_type: (vec { record { \"k\"; -2147483648 } }) round-trips";
assert blob "DIDL\02\6d\01\6c\02\00\7c\01\7d\01\00\01\81\80\80\e0\d1\e5\fc\9b\a3\da\a0\ea\7a\ff\ff\ff\9f\ae\9a\83\e4\dc\a5\df\95\05" == "(vec { record { -99999999999999999999999999; 99999999999999999999999999 } })" : (vec record { int; nat }) "serde.rs test_map_key_and_value_decode_under_own_type: (vec { record { -99999999999999999999999999; 99999999999999999999999999 } }) round-trips";
assert blob "DIDL\02\6d\01\6c\02\00\7c\01\7c\01\00\01\81\80\80\e0\d1\e5\fc\9b\a3\da\a0\ea\7a\81\80\80\e0\d1\e5\fc\9b\a3\da\a0\ea\7a" == "(vec { record { -99999999999999999999999999; -99999999999999999999999999 } })" : (vec record { int; int }) "serde.rs test_map_key_and_value_decode_under_own_type: (vec { record { -99999999999999999999999999; -99999999999999999999999999 } }) round-trips";
assert blob "DIDL\02\6d\01\6c\02\00\7d\01\7c\01\00\01\ff\ff\ff\9f\ae\9a\83\e4\dc\a5\df\95\05\81\80\80\e0\d1\e5\fc\9b\a3\da\a0\ea\7a" == "(vec { record { 99999999999999999999999999; -99999999999999999999999999 } })" : (vec record { nat; int }) "serde.rs test_map_key_and_value_decode_under_own_type: (vec { record { 99999999999999999999999999; -99999999999999999999999999 } }) round-trips";
assert blob "DIDL\02\6d\01\6c\02\00\7c\01\7d\01\00\02\7f\01\ff\00\e8\07" == "(vec { record { -1; 1 }; record { 127; 1000 } })" : (vec record { int; nat }) "serde.rs test_map_key_and_value_decode_under_own_type: (vec { record { -1; 1 }; record { 127; 1000 } }) round-trips";
assert blob "DIDL\02\6d\01\6c\02\00\7c\01\7d\01\00\01\05\07" !: (vec record { nat; nat }) "serde.rs test_map_key_and_value_decode_under_own_type: int key does not decode at nat";
assert blob "DIDL\02\6d\01\6c\02\00\7c\01\7c\01\00\01\05\07" !: (vec record { nat; int }) "serde.rs test_map_key_and_value_decode_under_own_type: int key does not decode at nat";
assert blob "DIDL\02\6d\01\6c\02\00\7d\01\7d\01\00\01\05\07" == "(vec { record { 5; 7 } })" : (vec record { int; int }) "serde.rs test_map_key_and_value_decode_under_own_type: (vec { record { 5; 7 } }) : (vec record { nat; nat }) decodes at (vec record { int; int }) to (vec { record { 5; 7 } })";
assert blob "DIDL\03\6d\01\6c\02\00\71\01\02\6d\7b\01\00\01\01\6b\05\68\65\6c\6c\6f" !: (vec record { text; text }) "serde.rs test_map_key_and_value_decode_under_own_type: blob value does not decode at text";
assert blob "DIDL\03\6d\01\6c\02\00\79\01\02\6d\7b\01\00\01\01\00\00\00\05\68\65\6c\6c\6f" !: (vec record { nat32; text }) "serde.rs test_map_key_and_value_decode_under_own_type: blob value does not decode at text";
assert blob "DIDL\02\6d\01\6c\02\00\71\01\71\01\00\01\01\6b\01\76" == "(vec { record { \"k\"; \"v\" } })" : (vec record { text; text }) "serde.rs test_map_key_and_value_decode_under_own_type: (vec { record { \"k\"; \"v\" } }) round-trips";
assert blob "DIDL\02\6d\01\6c\02\00\7d\01\71\01\00\01\01\01\76" == "(vec { record { 1; \"v\" } })" : (vec record { nat; text }) "serde.rs test_map_key_and_value_decode_under_own_type: (vec { record { 1; \"v\" } }) round-trips";
assert blob "DIDL\02\6d\01\6c\02\00\71\01\7d\01\00\01\01\6b\01" == "(vec { record { \"k\"; 1 } })" : (vec record { text; nat }) "serde.rs test_map_key_and_value_decode_under_own_type: (vec { record { \"k\"; 1 } }) round-trips";

// test_collection
assert blob "DIDL\02\6d\01\6c\02\00\71\01\75\01\00\01\01\61\01\00\00\00" == "(vec { record { \"a\"; 1 } })" : (vec record { text; int32 }) "serde.rs test_collection: decodes to (vec { record { \"a\"; 1 } })";
assert blob "DIDL\02\6d\01\6c\02\00\75\01\75\01\00\03\01\00\00\00\65\00\00\00\02\00\00\00\66\00\00\00\03\00\00\00\67\00\00\00" == "(vec { record { 1; 101 }; record { 2; 102 }; record { 3; 103 } })" : (vec record { int32; int32 }) "serde.rs test_collection: decodes to (vec { record { 1; 101 }; record { 2; 102 }; record { 3; 103 } })";
assert blob "DIDL\01\6d\75\01\00\03\01\00\00\00\02\00\00\00\03\00\00\00" == "(vec { 1; 2; 3 })" : (vec int32) "serde.rs test_collection: decodes to (vec { 1; 2; 3 })";

// test_tuple
assert blob "DIDL\01\6c\02\00\7c\01\71\01\00\2a\04\f0\9f\92\a9" == "(record { 42; \"💩\" })" : (record { int; text }) "serde.rs test_tuple: decodes to (record { 42; \"💩\" })";
assert blob "DIDL\04\6c\04\00\7c\01\7e\02\01\03\02\6d\7c\6e\03\6c\02\a0\d2\ac\a8\04\7c\90\ed\da\e7\04\02\01\00\2b\01\03\02\03\04\00" == "(record { 43; true; vec { 2; 3; 4 }; null })" : (record { int; bool; vec int; opt text }) "serde.rs test_tuple: opt List field decodes at opt text as null";
assert blob "DIDL\01\6c\02\00\7c\02\71\01\00\2a\04\f0\9f\92\a9" !: (record { int; text }) "serde.rs test_tuple: record { 0 : int; 2 : text } is not a tuple of 2";

// test_variant
assert blob "DIDL\01\6b\02\b3\d3\c9\01\7f\e6\fd\d5\01\7f\01\00\00" == "(variant { Bar })" : (Unit) "serde.rs test_variant: decodes to (variant { Bar })";
assert blob "DIDL\01\6b\02\b3\d3\c9\01\7f\e6\fd\d5\01\7f\01\00\03" !: (Unit) "serde.rs test_variant: Variant index 3 larger than length 2";
assert blob "DIDL\01\6b\02\b4\d3\c9\01\7f\e6\fd\d5\01\7f\01\00\00" !: (Unit) "serde.rs test_variant: Unknown variant field 3_303_860";
assert blob "DIDL\03\6b\03\b3\d3\c9\01\01\bb\d3\c9\01\02\e6\fd\d5\01\7f\6c\02\00\7e\01\7c\6c\02\61\7c\62\7d\01\00\00\01\2a" == "(variant { Bar = record { true; 42 } })" : (E) "serde.rs test_variant: decodes to (variant { Bar = record { true; 42 } })";
assert blob "DIDL\04\6e\01\6b\03\b3\d3\c9\01\02\bb\d3\c9\01\03\e6\fd\d5\01\7f\6c\02\00\7e\01\7c\6c\02\61\7c\62\7d\01\00\01\02" == "(opt variant { Foo })" : (opt Unit) "serde.rs test_variant: (opt variant { Foo }) : (opt E) decodes at (opt Unit) to (opt variant { Foo })";
assert blob "DIDL\03\6b\03\b3\d3\c9\01\01\bb\d3\c9\01\02\e6\fd\d5\01\7f\6c\02\00\7e\01\7c\6c\02\61\7c\62\7d\01\00\01\2a\2a" == "(null)" : (opt Unit) "serde.rs test_variant: (variant { Baz = record { a = 42; b = 42 } }) : (E) decodes at (opt Unit) to (null)";
assert blob "DIDL\03\6b\03\b3\d3\c9\01\01\bb\d3\c9\01\02\e6\fd\d5\01\7f\6c\02\00\7e\01\7c\6c\02\61\7c\62\7d\01\00\00\01\2a" == "(null)" : (opt Unit) "serde.rs test_variant: (variant { Bar = record { true; 42 } }) : (E) decodes at (opt Unit) to (null)";
assert blob "DIDL\03\6b\03\b3\d3\c9\01\01\bb\d3\c9\01\02\e6\fd\d5\01\7f\6c\02\00\7e\01\7c\6c\02\61\7c\62\7d\01\00\00\01\2a" !: (Unit) "serde.rs test_variant: variant { Bar = record {..} } : E does not decode at Unit (Subtyping error)";
assert blob "DIDL\02\6b\03\41\01\42\01\43\7f\6c\00\01\00\00" == "(variant { A = record {} })" : (variant { A : record {}; B : record {}; C }) "serde.rs test_variant: decodes to (variant { A = record {} })";

// test_field_rename
assert blob "DIDL\01\6c\02\61\77\62\7b\01\00\2a\2a" == "(record { a = 42; b = 42 })" : (record { a : int8; b : nat8 }) "serde.rs test_field_rename: decodes to (record { a = 42; b = 42 })";
assert blob "DIDL\01\6b\02\61\7f\62\7f\01\00\01" == "(variant { b })" : (variant { a; b }) "serde.rs test_field_rename: decodes to (variant { b })";
assert blob "DIDL\01\6b\02\b6\84\a7\02\7b\b4\93\ee\97\0d\77\01\00\01\2a" == "(variant { \"1-2 + 3\" = 42 })" : (variant { "1-2 + 3" : int8; "a-b" : nat8 }) "serde.rs test_field_rename: decodes to (variant { \"1-2 + 3\" = 42 })";
assert blob "DIDL\01\6c\02\b6\84\a7\02\7b\b4\93\ee\97\0d\77\01\00\2a\2a" == "(record { \"1-2 + 3\" = 42; \"a-b\" = 42 })" : (record { "1-2 + 3" : int8; "a-b" : nat8 }) "serde.rs test_field_rename: decodes to (record { \"1-2 + 3\" = 42; \"a-b\" = 42 })";

// test_generics
assert blob "DIDL\01\6c\02\ea\b3\01\7c\eb\b3\01\7e\01\00\2a\01" == "(record { g1 = 42; g2 = true })" : (record { g1 : int; g2 : bool }) "serde.rs test_generics: decodes to (record { g1 = 42; g2 = true })";

// test_multiargs
assert blob "DIDL\00\00" == "()" : () "serde.rs test_multiargs: decodes to ()";
assert blob "DIDL\01\6e\7c\04\7c\00\00\00\2a\01\2a\01\01\01\02" == "(42, opt 42, opt 1, opt 2)" : (int, opt int, opt int, opt int) "serde.rs test_multiargs: decodes to (42, opt 42, opt 1, opt 2)";
assert blob "DIDL\01\6e\7c\04\7c\00\00\00\2a\01\2a\01\01\01\02" == "(42)" : (int) "serde.rs test_multiargs: okay to decode fewer values from the message";
assert blob "DIDL\02\6d\01\6c\02\00\7c\01\71\02\00\01\01\2a\04\74\65\78\74\2a\04\74\65\78\74" == "(vec { record { 42; \"text\" } }, record { 42; \"text\" })" : (vec record { int; text }, record { int; text }) "serde.rs test_multiargs: decodes to (vec { record { 42; \"text\" } }, record { 42; \"text\" })";
assert blob "DIDL\02\6d\01\6c\02\00\7c\01\71\02\00\01\01\2a\04\74\65\78\74\2a\04\74\65\78\74" == "(vec { record { 42; \"text\" } }, record { 42; \"text\"; null }, null, null, null)" : (vec record { int; text }, record { int; text; null }, opt int32, null, reserved) "serde.rs test_multiargs: extra null field and missing opt/null/reserved arguments default";
