/*
Ported from dfinity/candid@572c80a rust/candid_parser/tests/compatibility.rs.
service_compatible(new, old) holds iff new <: old. Each case is a subtype assert
with the official idiom: (func () -> (service new)) decoded at
(opt func () -> (service old)) is a reference iff new <: old, else null.
Type definitions of each side are renamed apart (Rn/Ro, Vn/Vo, ...).
The error-message and report-format tests are not ported.
*/

type R1n = record { name : text; age : opt nat };
type R1o = record { name : text };
type R2n = record { id : nat; extra : opt text };
type R2o = record { id : nat };
type R3n = record { name : text };
type R3o = record { name : text; age : nat };
type V1n = variant { a; b; c };
type V1o = variant { a; b };
type R4n = record { name : text; age : nat };
type R4o = record { name : text };
type R5n = record { name : text };
type R5o = record { name : text; age : nat };
type V2n = variant { start; stop };
type V2o = variant { start; stop; pause };
type R6n = record { a : text; b : nat; c : bool };
type R6o = record { a : nat; b : text; c : bool };
type V3n = variant { a };
type V3o = variant { a; b; c };
type InnerN = record { x : text };
type OuterN = record { inner : InnerN };
type InnerO = record { x : nat };
type OuterO = record { inner : InnerO };
type Tn = record { a : text };
type To = record { a : nat };
type An = record { x : nat };
type Bo = record { x : text };
