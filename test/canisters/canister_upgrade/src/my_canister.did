type UpgradeRecord = record {
    init_count : nat64;
    pre_upgrade_count : nat64;
    post_upgrade_count : nat64;
    init_caller : text;
    pre_upgrade_caller : text;
    post_upgrade_caller : text;
    init_self : text;
    pre_upgrade_self : text;
    post_upgrade_self : text;
    init_version : nat64;
    pre_upgrade_version : nat64;
    post_upgrade_version : nat64;
};

service : {
    "get_upgrade_record" : () -> (UpgradeRecord) query;
    // Writes a file of n MiB, truncating what was there:
    // '("path", n)' -> '(bytes : nat64)'
    "write_file" : (text, nat32) -> (nat64);
    // Reads a file with one read that asks for more than it holds:
    // '("path")' -> '("bytes: 1048576; ok: true; instructions: 123")'
    "read_file" : (text) -> (text) query;
};
