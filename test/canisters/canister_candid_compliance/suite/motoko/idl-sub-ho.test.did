/*
Ported from dfinity/motoko test/run-drun/idl-sub-ho.mo.
Each //CALL is an assert at the method's parameter types (Motoko -> Candid:
Nat nat, Int int, Text text, Char nat32, Float float64, Any reserved, None empty,
Null null, ?T opt T, [T] vec T, (T, U) record { T; U } or an argument list,
{#a : T} variant { a : T }, actor {..} service {..}, shared .. -> async .. func).
A trap (IDL error) is !:, a reply is : (with the decoded value where useful).
The caller passes fX at a type of its own view; send_fN expects its declared type: wire <: expected.
*/
assert blob "DIDL\02\6a\00\01\01\00\6a\01\7c\01\7d\00\01\00\01\01\00\01\6d" == "(opt func \"aaaaa-aa\".m)" : (opt func () -> (func (nat) -> (int))) "idl-sub-ho.mo f0_1: func (int) -> (nat) <: func (nat) -> (int)";
assert blob "DIDL\02\6a\00\01\01\00\6a\00\02\7d\7e\00\01\00\01\01\00\01\6d" == "(opt func \"aaaaa-aa\".m)" : (opt func () -> (func (nat) -> (int))) "idl-sub-ho.mo f0_2: func () -> (nat, bool) <: func (nat) -> (int)";
assert blob "DIDL\03\6a\00\01\01\00\6a\02\7d\02\02\7c\02\00\6e\7d\01\00\01\01\00\01\6d" == "(opt func \"aaaaa-aa\".m)" : (opt func () -> (func (nat) -> (int))) "idl-sub-ho.mo f0_3: func (nat, opt nat) -> (int, opt nat) <: func (nat) -> (int)";
assert blob "DIDL\03\6a\00\01\01\00\6a\01\02\01\7c\00\6e\7e\01\00\01\01\00\01\6d" == "(opt func \"aaaaa-aa\".m)" : (opt func () -> (func (nat) -> (int))) "idl-sub-ho.mo f0_4: func (opt bool) -> (int) <: func (nat) -> (int)";
assert blob "DIDL\03\6a\00\01\01\00\6a\01\02\01\7e\00\6e\7d\01\00\01\01\00\01\6d" == "(opt func \"aaaaa-aa\".m)" : (opt func () -> (func (opt nat) -> (opt int))) "idl-sub-ho.mo f1_0: func (opt nat) -> (bool) <: func (opt nat) -> (opt int)";
assert blob "DIDL\08\6a\00\01\01\00\6a\04\7d\02\03\04\04\7c\05\06\07\00\6d\7d\6c\02\66\7d\67\7d\6b\02\6c\7d\6d\7d\6d\7c\6c\02\66\7c\67\7c\6b\02\6c\7c\6d\7c\01\00\01\01\00\01\6d" == "(opt func \"aaaaa-aa\".m)" : (opt func () -> (func (nat, vec nat, record { f : nat; g : nat }, variant { l : nat; m : nat }) -> (int, vec int, record { f : int; g : int }, variant { l : int; m : int }))) "idl-sub-ho.mo f2_0: func (nat, vec nat, record { f : nat; g : nat }, variant { l : nat; m : nat }) -> (int, vec int, record { f : int; g : int }, variant { l : int; m : int }) <: func (nat, vec nat, record { f : nat; g : nat }, variant { l : nat; m : nat }) -> (int, vec int, record { f : int; g : int }, variant { l : int; m : int })";
assert blob "DIDL\08\6a\00\01\01\00\6a\04\7c\02\03\04\04\7d\05\06\07\00\6d\7c\6c\01\66\7c\6b\03\6c\7c\6d\7c\6f\7c\6d\7d\6c\03\66\7d\67\7d\68\7d\6b\01\6c\7d\01\00\01\01\00\01\6d" == "(opt func \"aaaaa-aa\".m)" : (opt func () -> (func (nat, vec nat, record { f : nat; g : nat }, variant { l : nat; m : nat }) -> (int, vec int, record { f : int; g : int }, variant { l : int; m : int }))) "idl-sub-ho.mo f2_1: func (int, vec int, record { f : int }, variant { l : int; m : int; o : int }) -> (nat, vec nat, record { f : nat; g : nat; h : nat }, variant { l : nat }) <: func (nat, vec nat, record { f : nat; g : nat }, variant { l : nat; m : nat }) -> (int, vec int, record { f : int; g : int }, variant { l : int; m : int })";
assert blob "DIDL\03\6a\00\01\01\00\6a\00\03\7f\02\70\00\6e\6f\01\00\01\01\00\01\6d" == "(opt func \"aaaaa-aa\".m)" : (opt func () -> (func () -> (null, reserved, opt empty))) "idl-sub-ho.mo f3_0: func () -> (null, opt empty, reserved) <: func () -> (null, reserved, opt empty)";
assert blob "DIDL\0a\6a\00\01\01\00\6a\01\02\01\06\00\6c\04\61\7d\62\03\63\04\64\05\6d\7d\6c\02\66\7d\67\7d\6b\02\6c\7d\6d\7d\6c\04\61\7c\62\07\63\08\64\09\6d\7c\6c\02\66\7c\67\7c\6b\02\6c\7c\6d\7c\01\00\01\01\00\01\6d" == "(opt func \"aaaaa-aa\".m)" : (opt func () -> (func (record { a : nat; b : vec nat; c : record { f : nat; g : nat }; d : variant { l : nat; m : nat } }) -> (record { a : int; b : vec int; c : record { f : int; g : int }; d : variant { l : int; m : int } }))) "idl-sub-ho.mo f5_0: func (record { a : nat; b : vec nat; c : record { f : nat; g : nat }; d : variant { l : nat; m : nat } }) -> (record { a : int; b : vec int; c : record { f : int; g : int }; d : variant { l : int; m : int } }) <: func (record { a : nat; b : vec nat; c : record { f : nat; g : nat }; d : variant { l : nat; m : nat } }) -> (record { a : int; b : vec int; c : record { f : int; g : int }; d : variant { l : int; m : int } })";
assert blob "DIDL\0a\6a\00\01\01\00\6a\01\02\01\06\00\6c\04\61\7c\62\03\63\04\64\05\6d\7c\6c\01\66\7c\6b\03\6c\7c\6d\7c\6f\7c\6c\04\61\7d\62\07\63\08\64\09\6d\7d\6c\03\66\7d\67\7d\68\7d\6b\01\6c\7d\01\00\01\01\00\01\6d" == "(opt func \"aaaaa-aa\".m)" : (opt func () -> (func (record { a : nat; b : vec nat; c : record { f : nat; g : nat }; d : variant { l : nat; m : nat } }) -> (record { a : int; b : vec int; c : record { f : int; g : int }; d : variant { l : int; m : int } }))) "idl-sub-ho.mo f5_1: func (record { a : int; b : vec int; c : record { f : int }; d : variant { l : int; m : int; o : int } }) -> (record { a : nat; b : vec nat; c : record { f : nat; g : nat; h : nat }; d : variant { l : nat } }) <: func (record { a : nat; b : vec nat; c : record { f : nat; g : nat }; d : variant { l : nat; m : nat } }) -> (record { a : int; b : vec int; c : record { f : int; g : int }; d : variant { l : int; m : int } })";
assert blob "DIDL\04\6a\00\01\01\00\6a\00\01\02\00\6c\03\61\7f\62\03\63\70\6e\6f\01\00\01\01\00\01\6d" == "(opt func \"aaaaa-aa\".m)" : (opt func () -> (func () -> (record { a : null; b : reserved; c : opt empty }))) "idl-sub-ho.mo f6_0: func () -> (record { a : null; b : opt empty; c : reserved }) <: func () -> (record { a : null; b : reserved; c : opt empty })";
