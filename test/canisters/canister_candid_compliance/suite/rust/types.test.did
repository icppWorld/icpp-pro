/*
Ported from dfinity/candid@572c80a rust/candid/tests/types.rs (any_val only; the rest is Rust API).
any_val decodes a value at record { value : reserved }, i.e. the value is skipped as reserved.
*/

// types.rs any_val
assert blob "DIDL\04\6c\01\f1\fe\e1\8d\03\01\6b\04\b3\d3\c9\01\02\bb\d3\c9\01\03\e6\fd\d5\01\7f\fa\b5\b6\fa\0d\7e\6c\02\00\7e\01\75\6c\02\61\75\62\79\01\00\02" : (record { value : reserved }) "types.rs any_val: variant { Foo } decodes at reserved";
assert blob "DIDL\03\6b\04\b3\d3\c9\01\01\bb\d3\c9\01\02\e6\fd\d5\01\7f\fa\b5\b6\fa\0d\7e\6c\02\00\7e\01\75\6c\02\61\75\62\79\01\00\02" == "(variant { Foo })" : (variant { Foo; Bar : record { bool; int32 }; Baz : record { a : int32; b : nat32 }; Newtype : bool }) "types.rs any_val: (variant { Foo }) round-trips";
assert blob "DIDL\04\6c\01\f1\fe\e1\8d\03\01\6b\04\b3\d3\c9\01\02\bb\d3\c9\01\03\e6\fd\d5\01\7f\fa\b5\b6\fa\0d\7e\6c\02\00\7e\01\75\6c\02\61\75\62\79\01\00\00\01\2a\00\00\00" : (record { value : reserved }) "types.rs any_val: variant { Bar = record { true; 42 } } decodes at reserved";
assert blob "DIDL\03\6b\04\b3\d3\c9\01\01\bb\d3\c9\01\02\e6\fd\d5\01\7f\fa\b5\b6\fa\0d\7e\6c\02\00\7e\01\75\6c\02\61\75\62\79\01\00\00\01\2a\00\00\00" == "(variant { Bar = record { true; 42 } })" : (variant { Foo; Bar : record { bool; int32 }; Baz : record { a : int32; b : nat32 }; Newtype : bool }) "types.rs any_val: (variant { Bar = record { true; 42 } }) round-trips";
assert blob "DIDL\06\6c\01\f1\fe\e1\8d\03\01\6c\02\ea\b3\01\02\eb\b3\01\05\6b\04\b3\d3\c9\01\03\bb\d3\c9\01\04\e6\fd\d5\01\7f\fa\b5\b6\fa\0d\7e\6c\02\00\7e\01\75\6c\02\61\75\62\79\6c\02\ea\b3\01\02\eb\b3\01\02\01\00\00\01\2a\00\00\00\01\39\ff\ff\ff\0e\00\00\00\03\00" : (record { value : reserved }) "types.rs any_val: a nested record of variants decodes at reserved";
assert blob "DIDL\05\6c\02\ea\b3\01\01\eb\b3\01\04\6b\04\b3\d3\c9\01\02\bb\d3\c9\01\03\e6\fd\d5\01\7f\fa\b5\b6\fa\0d\7e\6c\02\00\7e\01\75\6c\02\61\75\62\79\6c\02\ea\b3\01\01\eb\b3\01\01\01\00\00\01\2a\00\00\00\01\39\ff\ff\ff\0e\00\00\00\03\00" == "(record { g1 = variant { Bar = record { true; 42 } }; g2 = record { g1 = variant { Baz = record { a = -199; b = 14 } }; g2 = variant { Newtype = false } } })" : (record { g1 : variant { Foo; Bar : record { bool; int32 }; Baz : record { a : int32; b : nat32 }; Newtype : bool }; g2 : record { g1 : variant { Foo; Bar : record { bool; int32 }; Baz : record { a : int32; b : nat32 }; Newtype : bool }; g2 : variant { Foo; Bar : record { bool; int32 }; Baz : record { a : int32; b : nat32 }; Newtype : bool } } }) "types.rs any_val: (record { g1 = variant { Bar = record { true; 42 } }; g2 = record { g1 = variant { Baz = record { a = -199; b = 14 } }; g2 = variant { Newtype = false } } }) round-trips";
