/*
Ported from dfinity/motoko test/run-drun/idl-large-principal.mo.
Each //CALL is an assert at the method's parameter types (Motoko -> Candid:
Nat nat, Int int, Text text, Char nat32, Float float64, Any reserved, None empty,
Null null, ?T opt T, [T] vec T, (T, U) record { T; U } or an argument list,
{#a : T} variant { a : T }, actor {..} service {..}, shared .. -> async .. func).
A trap (IDL error) is !:, a reply is : (with the decoded value where useful).
*/
assert blob "DIDL\00\01\68\01\1d\00\11\22\33\44\55\66\77\88\99\00\11\22\33\44\55\66\77\88\99\00\11\22\33\44\55\66\77\88" : (principal) "idl-large-principal.mo fun1: 29-byte principal";
assert blob "DIDL\00\01\68\01\1e\00\11\22\43\44\55\66\77\88\99\00\11\22\33\44\55\66\77\88\99\00\11\22\33\44\55\66\77\88\99" !: (principal) "idl-large-principal.mo fun1: 30-byte principal is too long";
assert blob "DIDL\01\69\00\01\00\01\1d\00\11\22\33\44\55\66\77\88\99\00\11\22\33\44\55\66\77\88\99\00\11\22\33\44\55\66\77\88" : (service {}) "idl-large-principal.mo fun2: 29-byte service principal";
assert blob "DIDL\01\69\00\01\00\01\1e\00\11\22\33\44\55\66\77\88\99\00\11\22\33\44\55\66\77\88\99\00\11\22\33\44\55\66\77\88\99" !: (service {}) "idl-large-principal.mo fun2: 30-byte service principal is too long";
assert blob "DIDL\01\6a\00\00\00\01\00\01\01\1d\00\11\22\33\44\55\66\77\88\99\00\11\22\33\44\55\66\77\88\99\00\11\22\33\44\55\66\77\88\00" : (func () -> ()) "idl-large-principal.mo fun3: 29-byte func principal";
assert blob "DIDL\01\6a\00\00\00\01\00\01\01\1e\00\11\22\33\44\55\66\77\88\99\00\11\22\33\44\55\66\77\88\99\00\11\22\33\44\55\66\77\88\99\00" !: (func () -> ()) "idl-large-principal.mo fun3: 30-byte func principal is too long";
