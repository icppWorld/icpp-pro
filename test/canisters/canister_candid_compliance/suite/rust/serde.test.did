/*
Ported from dfinity/candid@572c80a rust/candid/tests/serde.rs.
Rust types map to Candid types as the derive does: i32 -> int32, u64 -> nat64,
Int -> int, Nat -> nat, () -> null, Reserved -> reserved, Option<T> -> opt T,
Vec<T> -> vec T, tuples/tuple structs -> record { T; .. }, structs -> records,
enums -> variants, maps -> vec record { K; V }.
Encoding expectations from all_check are in encode.json; here they are decode asserts.
*/

type List = record { head : int; tail : opt List };
type ListOpt = opt ListA;
type ListA = record { head : int; tail : ListOpt };
type TypeA = record { typeb : opt TypeB };
type TypeB = record { typea : opt TypeA };
type RootType = record { typeas : vec TypeA };
type S = service { next : () -> (S) };
type Old = variant { Foo; Bar : bool };
type New = variant { Foo; Bar : bool; Baz : bool };
type OldStruct = record { bar : bool; baz : opt Old };
type NewStruct = record { foo : opt nat8; bar : bool; baz : opt New };
type E1 = variant { Foo; Bar };
type E2 = variant { Foo; Bar; Baz };
type A1 = record { foo : int32; bar : bool };
type A2 = record { foo : int32; bar : bool; baz : nat32; bbb : nat32; bib : E1; bab : A1 };
type Unit = variant { Foo; Bar };
type E = variant { Foo; Bar : record { bool; int }; Baz : record { a : int; b : nat } };

// test_error
assert blob "DID" !: (int32) "serde.rs test_error: io error (truncated magic)";
assert blob "DIDL" !: (int32) "serde.rs test_error: no type table length";
assert blob "DIDL\00\00" !: (int32) "serde.rs test_error: No more values on the wire";
assert blob "DIDL\01\7c" !: (int32) "serde.rs test_error: primitive opcode in the type table is not a valid future type";
assert blob "DIDL\02\6e\01\00" !: (int32) "serde.rs test_error: opcode 0 in the type table is not a valid future type (no infinite loop)";
assert blob "DIDL\00\01\7e\01\01" !: (bool) "serde.rs test_error: Trailing value after finishing deserialization";
assert blob "DIDL\00\01\00\01" !: (int32) "serde.rs test_error: type index 0 out of range";
assert blob "DIDL\02\6c\01\0a\01\6d\00\01\01\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20\20" !: (reserved) "serde.rs test_error: vec record { vec .. } nested 452 bytes deep: recursion limit or skipping cost";

// test_bool

// test_integer
assert blob "DIDL\00\01\7c\2a" == "(42)" : (int) "serde.rs test_integer: decodes to (42)";
assert blob "DIDL\00\01\7d\2a" == "(42)" : (nat) "serde.rs test_integer: decodes to (42)";
assert blob "DIDL\00\01\7c\d2\85\d8\cc\04" == "(1234567890)" : (int) "serde.rs test_integer: decodes to (1234567890)";
assert blob "DIDL\00\01\7d\d2\85\d8\cc\04" == "(1234567890)" : (nat) "serde.rs test_integer: decodes to (1234567890)";
assert blob "DIDL\00\01\7d\80\e4\97\d0\12" == "(5000000000)" : (nat) "serde.rs test_integer: decodes to (5000000000)";
assert blob "DIDL\00\01\7c\ae\fa\a7\b3\7b" == "(-1234567890)" : (int) "serde.rs test_integer: decodes to (-1234567890)";
assert blob "DIDL\00\01\7d\80\80\98\f4\e9\b5\ca\6a" == "(60000000000000000)" : (int) "serde.rs test_integer: nat 60000000000000000 decodes at int";
assert blob "DIDL\00\01\7c\2a" !: (int64) "serde.rs test_integer: int does not decode at int64";

