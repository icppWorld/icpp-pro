service : {
  // Callee methods
  "greet" : (text) -> (text);
  "reject_me" : () -> ();
  "trap_me" : () -> ();
  "accept_half" : () -> (nat64);
  "slow" : (nat32) -> ();
  "hold" : () -> ();
  "release" : () -> ();

  // Caller methods
  "call_greet" : (principal, text) -> (text);
  "call_reject" : (principal) -> (text);
  "call_trap" : (principal) -> (text);
  "call_then_trap" : (principal) -> ();
  "call_with_cycles" : (principal, nat64) -> (nat64, nat64);
  "call_bounded" : (principal, nat32, nat32) -> (text);
  "call_sequence" : (principal, text) -> (text);
  "call_chain" : (vec principal, text) -> (text);
  "call_oneway" : (principal) -> (bool);
  "task_greet" : (principal, text) -> (text);
  "task_nested" : (principal, text) -> (text);
  "task_then_trap" : (principal) -> ();
  "task_not_awaited" : () -> (nat64);
  "call_all" : (vec principal, vec text) -> (vec text);
  "call_all_then_trap" : (vec principal, vec text) -> ();
  "yield_loop" : (nat32) -> (text);
  "budget_probe" : (nat32) -> (vec nat64, vec nat64);
  "start_held_call" : (principal) -> ();
  "compute" : (nat32, nat64, nat64, nat64, bool) -> (nat64, nat32, nat64, nat64);
  "compute_no_yield" : (nat64, nat64) -> (nat64);
  "get_job" : (nat32) -> (nat64, nat64) query;
  "get_run_log" : () -> (vec nat32) query;
  "clear_run_log" : () -> ();
  "greet_q" : (text) -> (text) query;
  "cq_name" : () -> (text) composite_query;
  "cq_greet" : (principal, text) -> (text) composite_query;
  "cq_all" : (vec principal) -> (vec text) composite_query;
  "cq_call_update" : (principal) -> (text) composite_query;
  "call_cq" : (principal) -> (text);
  "cq_in_callback" : (principal, text) -> (text) composite_query;
  "cq_then_trap" : (principal) -> () composite_query;
  "info" : (principal) -> (text);
  "info_cq" : (principal) -> (text) composite_query;
  "cq_via" : (principal, principal) -> (text) composite_query;
  "timer_call" : (principal, text, principal) -> ();
  "timer_result" : () -> (text) query;
  "get_state" : () -> (nat64, nat64, nat64, nat32, bool) query;
};
