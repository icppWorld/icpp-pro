// compatible_service_changes
assert blob "DIDL\03\6a\00\01\01\00\69\01\05\67\72\65\65\74\02\6a\01\71\01\71\00\01\00\01\01\00\01\6d" == "(opt func \"aaaaa-aa\".m)" : (opt func () -> (service { greet : (text) -> (text) })) "compatibility.rs compatible_service_changes: identical service";
assert blob "DIDL\04\6a\00\01\01\00\69\02\05\67\72\65\65\74\02\05\68\65\6c\6c\6f\03\6a\01\71\01\71\00\6a\00\01\71\00\01\00\01\01\00\01\6d" == "(opt func \"aaaaa-aa\".m)" : (opt func () -> (service { greet : (text) -> (text) })) "compatibility.rs compatible_service_changes: add new method";
assert blob "DIDL\03\6a\00\01\01\00\69\01\03\70\61\79\02\6a\01\7c\00\00\01\00\01\01\00\01\6d" == "(opt func \"aaaaa-aa\".m)" : (opt func () -> (service { pay : (nat) -> () })) "compatibility.rs compatible_service_changes: widen input nat -> int";
assert blob "DIDL\03\6a\00\01\01\00\69\01\03\67\65\74\02\6a\00\01\7d\00\01\00\01\01\00\01\6d" == "(opt func \"aaaaa-aa\".m)" : (opt func () -> (service { get : () -> (int) })) "compatibility.rs compatible_service_changes: narrow return int -> nat";

// compatible_record_field_changes
assert blob "DIDL\05\6a\00\01\01\00\69\01\01\66\02\6a\01\03\00\00\6c\02\bf\e9\a7\02\04\cb\e4\fd\c7\04\71\6e\7d\01\00\01\01\00\01\6d" == "(opt func \"aaaaa-aa\".m)" : (opt func () -> (service { f : (R1o) -> () })) "compatibility.rs compatible_record_field_changes: add opt field to input record";
assert blob "DIDL\05\6a\00\01\01\00\69\01\01\66\02\6a\00\01\03\00\6c\02\db\b7\01\7d\90\b5\8a\b9\07\04\6e\71\01\00\01\01\00\01\6d" == "(opt func \"aaaaa-aa\".m)" : (opt func () -> (service { f : () -> (R2o) })) "compatibility.rs compatible_record_field_changes: add opt field to return record";
assert blob "DIDL\04\6a\00\01\01\00\69\01\01\66\02\6a\00\01\03\00\6c\02\61\7d\62\7f\01\00\01\01\00\01\6d" == "(opt func \"aaaaa-aa\".m)" : (opt func () -> (service { f : () -> (record { a : nat }) })) "compatibility.rs compatible_record_field_changes: add null field to return record";
assert blob "DIDL\04\6a\00\01\01\00\69\01\01\66\02\6a\00\01\03\00\6c\02\61\7d\62\70\01\00\01\01\00\01\6d" == "(opt func \"aaaaa-aa\".m)" : (opt func () -> (service { f : () -> (record { a : nat }) })) "compatibility.rs compatible_record_field_changes: add reserved field to return record";
assert blob "DIDL\04\6a\00\01\01\00\69\01\01\66\02\6a\01\03\00\00\6c\01\cb\e4\fd\c7\04\71\01\00\01\01\00\01\6d" == "(opt func \"aaaaa-aa\".m)" : (opt func () -> (service { f : (R3o) -> () })) "compatibility.rs compatible_record_field_changes: remove non-opt field from input record";

// compatible_variant_and_vec_changes
assert blob "DIDL\04\6a\00\01\01\00\69\01\01\66\02\6a\01\03\00\00\6b\03\61\7f\62\7f\63\7f\01\00\01\01\00\01\6d" == "(opt func \"aaaaa-aa\".m)" : (opt func () -> (service { f : (V1o) -> () })) "compatibility.rs compatible_variant_and_vec_changes: add variant case to input";
assert blob "DIDL\04\6a\00\01\01\00\69\01\01\66\02\6a\00\01\03\00\6d\7d\01\00\01\01\00\01\6d" == "(opt func \"aaaaa-aa\".m)" : (opt func () -> (service { f : () -> (vec nat) })) "compatibility.rs compatible_variant_and_vec_changes: identical vec types";

// incompatible_method_changes
assert blob "DIDL\03\6a\00\01\01\00\69\01\05\67\72\65\65\74\02\6a\01\71\01\71\00\01\00\01\01\00\01\6d" == "(null)" : (opt func () -> (service { greet : (text) -> (text); hello : () -> (text) })) "compatibility.rs incompatible_method_changes: remove method";
assert blob "DIDL\03\6a\00\01\01\00\69\01\03\67\65\74\02\6a\00\01\7d\00\01\00\01\01\00\01\6d" == "(null)" : (opt func () -> (service { get : () -> (nat) query })) "compatibility.rs incompatible_method_changes: change func mode query -> update";
assert blob "DIDL\03\6a\00\01\01\00\69\01\03\67\65\74\02\6a\00\01\71\00\01\00\01\01\00\01\6d" == "(null)" : (opt func () -> (service { get : () -> (nat) })) "compatibility.rs incompatible_method_changes: change return type nat -> text";
assert blob "DIDL\03\6a\00\01\01\00\69\01\03\73\65\74\02\6a\01\71\00\00\01\00\01\01\00\01\6d" == "(null)" : (opt func () -> (service { set : (nat) -> () })) "compatibility.rs incompatible_method_changes: change input type nat -> text";
assert blob "DIDL\03\6a\00\01\01\00\69\01\03\67\65\74\02\6a\00\01\7c\00\01\00\01\01\00\01\6d" == "(null)" : (opt func () -> (service { get : () -> (nat) })) "compatibility.rs incompatible_method_changes: widen return nat -> int";

// incompatible_record_and_variant_changes
assert blob "DIDL\04\6a\00\01\01\00\69\01\01\66\02\6a\01\03\00\00\6c\02\bf\e9\a7\02\7d\cb\e4\fd\c7\04\71\01\00\01\01\00\01\6d" == "(null)" : (opt func () -> (service { f : (R4o) -> () })) "compatibility.rs incompatible_record_and_variant_changes: add required field to input record";
assert blob "DIDL\04\6a\00\01\01\00\69\01\01\66\02\6a\00\01\03\00\6c\01\cb\e4\fd\c7\04\71\01\00\01\01\00\01\6d" == "(null)" : (opt func () -> (service { f : () -> (R5o) })) "compatibility.rs incompatible_record_and_variant_changes: remove required field from return record";
assert blob "DIDL\04\6a\00\01\01\00\69\01\01\66\02\6a\01\03\00\00\6b\02\82\e0\ef\e2\04\7f\e2\e8\ad\a0\08\7f\01\00\01\01\00\01\6d" == "(null)" : (opt func () -> (service { f : (V2o) -> () })) "compatibility.rs incompatible_record_and_variant_changes: remove variant case from input";
assert blob "DIDL\04\6a\00\01\01\00\69\01\01\66\02\6a\00\01\03\00\6d\71\01\00\01\01\00\01\6d" == "(null)" : (opt func () -> (service { f : () -> (vec nat) })) "compatibility.rs incompatible_record_and_variant_changes: change vec element type";
// "change a field reached again after a failed opt probe" is not ported: its recursive
// records have no finite value, so they decode as empty; see canister_1's test_subtype_assumptions

// collects_all_incompatible_methods
assert blob "DIDL\04\6a\00\01\01\00\69\02\08\6d\65\74\68\6f\64\5f\61\02\08\6d\65\74\68\6f\64\5f\63\03\6a\01\7d\01\7d\00\6a\00\01\71\00\01\00\01\01\00\01\6d" == "(null)" : (opt func () -> (service { method_a : (nat) -> (nat); method_b : (text) -> (text); method_c : () -> (nat); method_d : () -> () })) "compatibility.rs collects_all_incompatible_methods: two methods removed, one return changed";

// collects_all_incompatible_record_fields
assert blob "DIDL\04\6a\00\01\01\00\69\01\01\66\02\6a\00\01\03\00\6c\03\61\71\62\7d\63\7e\01\00\01\01\00\01\6d" == "(null)" : (opt func () -> (service { f : () -> (R6o) })) "compatibility.rs collects_all_incompatible_record_fields: fields a and b changed";

// collects_both_input_and_return_errors
assert blob "DIDL\03\6a\00\01\01\00\69\01\04\63\61\6c\6c\02\6a\01\71\01\7e\00\01\00\01\01\00\01\6d" == "(null)" : (opt func () -> (service { call : (nat) -> (nat) })) "compatibility.rs collects_both_input_and_return_errors: input and return changed";

// collects_variant_field_errors
assert blob "DIDL\04\6a\00\01\01\00\69\01\01\66\02\6a\01\03\00\00\6b\01\61\7f\01\00\01\01\00\01\6d" == "(null)" : (opt func () -> (service { f : (V3o) -> () })) "compatibility.rs collects_variant_field_errors: input variant cases b and c removed";

// missing_method_error_is_clear
assert blob "DIDL\03\6a\00\01\01\00\69\01\07\62\61\6c\61\6e\63\65\02\6a\00\01\7d\00\01\00\01\01\00\01\6d" == "(null)" : (opt func () -> (service { transfer : (nat) -> (); balance : () -> (nat) })) "compatibility.rs missing_method_error_is_clear: method transfer removed";

// nested_path_shows_full_context
assert blob "DIDL\05\6a\00\01\01\00\69\01\03\67\65\74\02\6a\00\01\03\00\6c\01\96\e3\f0\f0\0b\04\6c\01\78\71\01\00\01\01\00\01\6d" == "(null)" : (opt func () -> (service { get : () -> (OuterO) })) "compatibility.rs nested_path_shows_full_context: nested field x changed nat -> text";

