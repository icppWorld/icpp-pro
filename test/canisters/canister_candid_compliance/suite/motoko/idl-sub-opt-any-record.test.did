/*
Ported from dfinity/motoko test/run-drun/idl-sub-opt-any-record.mo.
Each //CALL is an assert at the method's parameter types (Motoko -> Candid:
Nat nat, Int int, Text text, Char nat32, Float float64, Any reserved, None empty,
Null null, ?T opt T, [T] vec T, (T, U) record { T; U } or an argument list,
{#a : T} variant { a : T }, actor {..} service {..}, shared .. -> async .. func).
A trap (IDL error) is !:, a reply is : (with the decoded value where useful).
*/
assert blob "DIDL\04\6a\00\01\01\00\6a\01\02\01\03\00\6c\02\61\7c\6e\7f\6c\02\62\7e\78\7f\01\00\01\01\00\01\6d" == "(opt func \"aaaaa-aa\".m)" : (opt func () -> (func (record { a : int }) -> (record { b : bool }))) "idl-sub-opt-any-record.mo f0_1_a: func (record { a : int; n : null }) -> (record { b : bool; x : null }) <: func (record { a : int }) -> (record { b : bool })";
assert blob "DIDL\05\6a\00\01\01\00\6a\01\02\01\04\00\6c\02\61\7c\6e\03\6e\7f\6c\02\62\7e\78\03\01\00\01\01\00\01\6d" == "(opt func \"aaaaa-aa\".m)" : (opt func () -> (func (record { a : int }) -> (record { b : bool }))) "idl-sub-opt-any-record.mo f0_1_b: func (record { a : int; n : opt null }) -> (record { b : bool; x : opt null }) <: func (record { a : int }) -> (record { b : bool })";
assert blob "DIDL\04\6a\00\01\01\00\6a\01\02\01\03\00\6c\02\61\7c\6e\70\6c\02\62\7e\78\70\01\00\01\01\00\01\6d" == "(opt func \"aaaaa-aa\".m)" : (opt func () -> (func (record { a : int }) -> (record { b : bool }))) "idl-sub-opt-any-record.mo f0_1_c: func (record { a : int; n : reserved }) -> (record { b : bool; x : reserved }) <: func (record { a : int }) -> (record { b : bool })";
